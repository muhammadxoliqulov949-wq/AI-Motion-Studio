REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=

OPENAI_API_KEY=
# Native Uzbek (and Russian / English / Turkish) neural voices for voiceovers: Azure AI Speech
# (free tier: 500k characters / month). Create a "Speech" resource, then copy its key and region (e.g. westeurope).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Stock video/photo library for the editor and AI Montaj (free key: https://pixabay.com/api/docs/).
PIXABAY_API_KEY=
# Optional fallback stock provider (https://www.pexels.com/api/)
PEXELS_API_KEY=
# AI Studio (/montage): images and AI video through Pollinations. A FREE key (enter.pollinations.ai) gives
# unlimited free image models without watermark. Without it the studio runs in trial mode (1 image per
# 45 s for all users, watermarked). AI video models are paid per second (credits called "pollen", $1 = 1):
# top up the same account to enable them; GEN_ALLOW_VIDEO=0 switches AI video off even with a key.
POLLINATIONS_API_KEY=
GEN_ALLOW_VIDEO=1
# Editor stickers: GIPHY stickers & GIFs (free key: https://developers.giphy.com/)
GIPHY_API_KEY=
# Editor "Audio > Onlayn" sound-effect search, CC0 / CC BY only (free key: https://freesound.org/apiv2/apply)
# (Pixabay's API has no sound or music endpoint, so it cannot serve this.)
FREESOUND_API_KEY=

# Supabase: accounts, cloud projects, media storage (run supabase/migrations/*.sql once)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: lets /api/music cache library tracks in the public "music" bucket (never expose it to the browser)
SUPABASE_SERVICE_ROLE_KEY=
